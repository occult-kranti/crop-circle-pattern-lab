_hochberg(np.array([p_pair[p] for p in cross]), q=0.10)
med, mad = np.median(Dcross), median_abs_deviation(Dcross)
interesting = [p for p in cross
               if D[p] <= 0.25 and p_pair[p] <= 0.05
               and n_feature_groups_agree(p) >= 2
               and (med - D[p])/mad >= 2]
```

