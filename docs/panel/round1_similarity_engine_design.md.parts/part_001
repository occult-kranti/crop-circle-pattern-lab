# ---------- distances ----------
def d_sym(a, b):
    if a is None or b is None: return np.nan
    if a == b: return 0.0
    if -1 in (a, b) or 0 in (a, b): return 1.0      # INF or radial-null vs anything finite
    r = np.log2(a / b)
    return min(abs(r), abs(r-1), abs(r+1)) / 1.5

def d_mode(m1, m2):                                  # m = (n, m)
    if m1 is None or m2 is None: return np.nan
    n1, k1 = m1; n2, k2 = m2
    dn = min(abs(n1-n2), abs(2*n1-n2), abs(n1-2*n2)) / max(n1, n2, 1)
    dm = abs(k1-k2) / max(k1, k2)
    j1 = jn_zeros(n1, k1)[-1]; j2 = jn_zeros(n2, k2)[-1]
    db = min(abs(j1-j2) / ((j1+j2)/2) / 0.05, 1.0)
    return 0.5*(dn+dm)/2 + 0.5*db

def pair_dist(A, B, scalers):
    parts, wts = [], []
    d = d_sym(A['n_fold'], B['n_fold'])
    if not np.isnan(d): parts.append(d); wts.append(0.20)
    d = d_mode(A['mode'], B['mode'])
    if not np.isnan(d): parts.append(d); wts.append(0.20)
    parts.append(np.linalg.norm(A['ratio_sig']-B['ratio_sig'])/np.sqrt(6)); wts.append(0.15)
    if A['fd'] is not None and B['fd'] is not None:
