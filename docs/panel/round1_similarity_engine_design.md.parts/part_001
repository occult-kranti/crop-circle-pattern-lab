# ---------- build ----------
CANON = np.array([1.618, 1.414, 1.732, 2.0, 3.0, np.pi])   # φ, √2, √3, 2, 3, π
def encode_ratio_sig(ratios, sigma=0.02):
    v = np.zeros(6)
    for r in ratios:
        folds = [r * 2.0**k for k in (-1,0,1)] + [r * 1.618**k for k in (-1,0,1)]
        for rf in folds:
            v = np.maximum(v, np.exp(-(np.log(rf) - np.log(CANON))**2 / (2*sigma**2)))
    return v

def fourier_desc(img):                # img: 512x512 binary, centered
    s   = radial_signature(img, n_theta=1024)      # max-radius ray cast
    S   = np.fft.fft(s)
    F   = np.abs(S[1:33]) / S[0]                   # rotation+shift+scale invariant
    return F / np.linalg.norm(F)

def build_item(meta, img=None):
    return dict(n_fold=meta.n_fold,                 # 0, k, or INF(-1)
                flags=np.array([meta.is_spiral, meta.is_grid, meta.is_concentric, meta.chiral]),
                log_size=np.log10(meta.size_m) if meta.size_m else np.nan,
                mode=(meta.mode_n, meta.mode_m) if meta.has_mode else None,
                ratio_sig=encode_ratio_sig(meta.ratios),
