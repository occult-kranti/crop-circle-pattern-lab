def test_plate_dispersion_option():
    """Physics §1b: plate option f ∝ (p²+q²), membrane f ∝ √(p²+q²);
    models tagged and divergent at high mode number."""
    fm = cym.frequency_square(2, 3, 0.3, 1000.0, dispersion="membrane")
    fp = cym.frequency_square(2, 3, 0.3, 1000.0, dispersion="plate")
    ok = abs(fm / (1000 / 0.6) - math.sqrt(13)) < 1e-9
    ok &= abs(fp / (1000 / 0.09) - 13.0) < 1e-9
    try:
        cym.frequency_square(1, 1, 0.3, 1000.0, dispersion="bogus")
        ok = False
    except ValueError:
        pass
    check("physics: square membrane vs biharmonic-plate dispersion options", ok)


def test_bessel_exact_beyond_printed_table():
    """Regression: bessel_zero must use scipy.special.jn_zeros for ALL
    (n, m) in its practical range (n ≤ 100, m ≤ 20), not just the printed
    §1a table (n ≤ 8).  The asymptotic at (10,1) errs by +2.35 %, which
    corrupted pattern 9's ratios.  The asymptotic remains ONLY as the
    true fallback beyond scipy's range."""
    from scipy.special import jn_zeros
    r = cym.frequency_ratio_membrane(10, 1)
    exact = jn_zeros(10, 1)[0] / jn_zeros(0, 1)[0]
    ok = abs(r - exact) < 1e-10
    ok &= abs(r - 6.01936) < 5e-5                       # was 6.16056 (wrong)
    ok &= abs(cym.frequency_ratio_membrane(10, 2) - 7.66520) < 5e-5
    # spot-check the whole scipy range is exact, not asymptotic
    for n, m in [(9, 1), (10, 3), (50, 1), (100, 1), (0, 20), (33, 20)]:
        ok &= cym.bessel_zero(n, m) == jn_zeros(n, m)[m - 1]
    # asymptotic is retained only as true fallback beyond n=100 / m=20
    ok &= cym.bessel_zero(101, 1) == cym.asymptotic_zero(101, 1)
    ok &= cym.bessel_zero(0, 21) == cym.asymptotic_zero(0, 21)
    check("physics: Bessel zeros exact (scipy) beyond printed table; "
          "(10,1) ratio 6.01936", ok, f"(10,1) ratio {r}")


