    ok &= cats[("bad", "neg")]["category"] == "INVALID"
    ok &= all("invalid frequency" in p["flags"][0]
              for p in bt["pairs"])
    check("presentation: invalid frequency flags + INVALID beat category "
          "for NaN/negative", ok)


