    """§5: freq_to_note(-5)/NaN must flag 'invalid frequency' (not 'f = 0');
    NaN/negative Δf must yield an INVALID beat category, not a silently
    fabricated DIFFERENCE TONE."""
    r_neg = notes.freq_to_note(-5.0)
    r_nan = notes.freq_to_note(float("nan"))
    ok = (r_neg["note"] is None and r_neg["flags"]
          and "invalid frequency" in r_neg["flags"][0]
          and "f = 0" not in r_neg["flags"][0])
    ok &= (r_nan["note"] is None and r_nan["flags"]
           and "invalid frequency" in r_nan["flags"][0])
    ok &= notes.beat_category(float("nan")).startswith("INVALID")
    ok &= notes.beat_category(-2.0).startswith("INVALID")
    # beat_table with NaN / negative inputs: explicit INVALID rows, no crash
    bt = notes.beat_table({"ok": 440.0, "bad": float("nan"),
                           "neg": -100.0})
