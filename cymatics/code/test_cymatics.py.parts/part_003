equency → dominant weight on that mode;
    drive far off-peak → suppression (no dominant mode)."""
    R, c = 0.15, 100.0
    modes = [(n, m, cym.frequency_membrane(n, m, R, c))
             for (n, m) in [(0, 1), (1, 1), (2, 1), (0, 2), (3, 1)]]
    f11 = cym.frequency_membrane(1, 1, R, c)
    # on-peak: (1,1) must dominate decisively with modest damping
    w = cym.lorentzian_superposition(modes, f11, gamma=5.0)
    ok = (w[0]["n"], w[0]["m"]) == (1, 1) and w[0]["weight"] > 0.99
    ok &= abs(sum(x["weight"] for x in w) - 1.0) < 1e-12
    # off-peak: log-midpoint between f(1,1) and f(2,1), sharp gamma →
    # the two neighbours split the weight, nothing dominates
    f_off = math.sqrt(f11 * cym.frequency_membrane(2, 1, R, c))
    w_off = cym.lorentzian_superposition(modes, f_off, gamma=5.0)
    ok &= w_off[0]["weight"] < 0.6
    # suppression: driven far from every mode (1200 Hz, all modes < 700 Hz),
    # no mode approaches the on-peak dominance
    f01 = cym.frequency_membrane(0, 1, R, c)
    w_on = cym.lorentzian_superposition(modes, f01, gamma=5.0)[0]["weight"]
    w_far = cym.lorentzian_superposition(modes, 1200.0, gamma=5.0)[0]["weight"]
    ok &= w_far < 0.5 * w_on
    check("v2: Lorentzian peak sanity (on-peak dominant, off-peak suppressed)",
          ok, f"on-peak w={w[0]['weight']:.4f}, off top={w_off[0]['weight']:.3f}")


def test_lorentzian_edge_cases():
    """v2: γ→0 clamp (no NaN), f=0, negative γ rejection, bad modes."""
    ok = True
    # gamma=0, drive exactly on a mode → weight 1.0 for it, finite, sums to 1
    w = cym.lorentzian_superposition([(0, 1, 100.0), (1, 1, 200.0)], 100.0,
                                     gamma=0.0)
    ok &= (w[0]["weight"] > 1.0 - 1e-12 and (w[0]["n"], w[0]["m"]) == (0, 1)
           and all(math.isfinite(x["weight"]) for x in w)
           and abs(sum(x["weight"] for x in w) - 1.0) < 1e-12)
    # two degenerate modes exactly on-peak with γ=0 → split 50/50, no NaN
    w2 = cym.lorentzian_superposition([(0, 1, 100.0), (1, 0, 100.0)], 100.0,
                                      gamma=0.0)
    ok &= abs(w2[0]["weight"] - 0.5) < 1e-9
    # drive f=0 → legal, all off-resonance, normalized, finite
    w0 = cym.lorentzian_superposition([(0, 1, 255.2), (1, 1, 406.5)], 0.0)
    ok &= (abs(sum(x["weight"] for x in w0) - 1.0) < 1e-12
           and all(math.isfinite(x["weight"]) for x in w0))
    # clean rejections
    for fn in (lambda: cym.lorentzian_superposition([(0, 1, 100.0)], 100.0,
                                                    gamma=-1.0),
               lambda: cym.lorentzian_superposition([(0, 1, 100.0)], -5.0),
               lambda: cym.lorentzian_superposition([(0, 1, 100.0)],
                                                    float("nan")),
               lambda: cym.lorentzian_superposition([], 100.0),
               lambda: cym.lorentzian_superposition([(0, 1)], 100.0),
               lambda: cym.lorentzian_superposition([(0, 1, float("nan"))],
