def test_membrane_pattern_analytic_parity():
    """v2 parity: rendered membrane field equals the analytic J_n(z·r/R)·cos(nθ)
    on sampled points; (0,1) is maximal at the center (J_0(0)=1)."""
    from scipy.special import jn
    pat = cym.membrane_pattern(3, 2, R=1.0, res=512, phase=0.17)
    z = cym.bessel_zero(3, 2)
    rng = np.random.default_rng(3)
    ok = True
    for _ in range(40):
        i = rng.integers(0, 512)
        j = rng.integers(0, 512)
        x, y = pat["x"][j], pat["y"][i]
        r = math.hypot(x, y)
        if r > 1.0:
            ok &= pat["u"][i, j] == 0.0
            continue
        ref = jn(3, z * r) * math.cos(3 * math.atan2(y, x) + 0.17)
        ok &= abs(pat["u"][i, j] - ref) < 1e-12
    pat01 = cym.membrane_pattern(0, 1, res=256)
    c = 127  # y=0 row nearest the center (x=0 col on symmetric grid: 127/128)
    center = max(pat01["amplitude"][c, c], pat01["amplitude"][c + 1, c + 1])
    ok &= abs(center - 1.0) < 0.01  # J_0(0)=1, grid half-pixel off center
    ok &= abs(pat01["amplitude"].max() - 1.0) < 0.01
    check("v2: membrane pattern matches analytic J_n(z·r/R)·cos(nθ+φ)", ok)


