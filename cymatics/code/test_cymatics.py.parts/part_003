            fn()
            ok = False
        except ValueError:
            pass
        except Exception:
            ok = False
    check("v2: Lorentzian edge cases (γ→0 clamp, f=0, γ<0 rejected)", ok)


def test_free_rim_zero_table():
    """v2: free-rim zeros z'_{n,m} — monotonic in m, scipy-consistent,
    A&S spot values, J'_0 = −J_1 identity."""
    ok = True
    tab = cym.bessel_derivative_zeros(8, 6)
    # strict monotonicity in m for every n
    for n in range(0, 9):
        ok &= bool(np.all(np.diff(tab[n]) > 0))
    # monotonic in n for n ≥ 1 at fixed m (n=0 row is the J1 row, exempt)
    for m in range(1, 7):
        col = [tab[n, m - 1] for n in range(1, 9)]
        ok &= bool(np.all(np.diff(col) > 0))
    # A&S Table 9.5 spot values (1e-8 — the printed table is rounded)
    refs = {(0, 1): 3.8317059702, (1, 1): 1.8411837813, (2, 1): 3.0542369282,
            (3, 1): 4.2011889412, (1, 2): 5.3314427735, (5, 3): 13.9871886301,
            (4, 5): 19.1960288050}
    for (n, m), v in refs.items():
        ok &= abs(cym.bessel_derivative_zero(n, m) - v) < 1e-8
    # identity J'_0 = −J_1 → row 0 of J' table == row 1 of J table
    for m in range(1, 7):
        ok &= abs(cym.bessel_derivative_zero(0, m)
                  - cym.bessel_zero(1, m)) < 1e-12
    # consistency with scipy.special.jnp_zeros directly across its range
    from scipy.special import jnp_zeros
    for n in (0, 1, 5, 33, 100):
        for m in (1, 7, 20):
            ok &= cym.bessel_derivative_zero(n, m) == jnp_zeros(n, m)[m - 1]
    check("v2: free-rim zeros monotonic + A&S spots + J'₀=−J₁ identity", ok)


def test_free_rim_frequency_scaling():
    """v2: free-rim ratios f'_{n,m}/f'_{0,1} = z'_{n,m}/z'_{0,1} exactly;
    f ∝ c and f ∝ 1/R preserved; guard rails."""
    ok = True
    for n in range(0, 6):
        for m in range(1, 5):
            a = cym.frequency_membrane_free(n, m, 0.15, 100.0)
            b = cym.frequency_membrane_free(0, 1, 0.15, 100.0)
            ok &= abs(a / b - cym.bessel_derivative_zero(n, m)
                      / cym.bessel_derivative_zero(0, 1)) < 1e-12
    f1 = cym.frequency_membrane_free(2, 1, R=0.15, c=100.0)
    ok &= abs(cym.frequency_membrane_free(2, 1, R=0.075, c=100.0) / f1 - 2.0) < 1e-12
    ok &= abs(cym.frequency_membrane_free(2, 1, R=0.15, c=200.0) / f1 - 2.0) < 1e-12
    # free rim lowers every mode vs clamped rim (z'_{n,m} < z_{n,m} for n ≥ 1)
    ok &= all(cym.bessel_derivative_zero(n, 1) < cym.bessel_zero(n, 1)
              for n in range(1, 9))
    for fn in (lambda: cym.frequency_membrane_free(0, 1, 0.0, 100.0),
               lambda: cym.frequency_membrane_free(0, 1, 0.15, 0.0),
               lambda: cym.frequency_membrane_free(-1, 1, 0.15, 100.0),
               lambda: cym.bessel_derivative_zero(0, 0)):
        try:
            fn()
            ok = False
        except ValueError:
            pass
        except Exception:
            ok = False
    check("v2: free-rim frequency ratios + scaling + guard rails", ok)


