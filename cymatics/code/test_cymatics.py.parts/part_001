def _spiral_image(arms, b, chirality, beads=24, res=384):
    """Beads on logarithmic spiral arms, generator θ = χ·ln(r/r0)/b (§7 n.3)."""
    img = np.zeros((res, res))
    yy, xx = np.mgrid[0:res, 0:res]
    c = (res - 1) / 2.0
    R = c * 0.97
    r0 = 0.08 * R
    t_max = np.log(R / r0) / b
    for a in range(arms):
        for t in np.linspace(0, t_max, beads):
            rr = r0 * np.exp(b * t)
            th = chirality * t + 2 * np.pi * a / arms
            img += np.exp(-(((xx - (c + rr * np.cos(th))) ** 2
                             + (yy - (c + rr * np.sin(th))) ** 2)
                            / (2 * 4.6 ** 2)))
    return img


def test_spiral_chirality():
    """V5: 3-arm log spiral, both chiralities → n̂=3, χ correct & opposite,
    C < C_lo; standing (3,1) has C ≈ 1 and is NOT a spiral (§4.3)."""
    ok = True
    chis = []
    for chir in (+1, -1):
        cands, diag = dec.decode_image(_spiral_image(3, 0.4, chir),
                                       return_diagnostics=True)
        ok &= diag["route"] == "SPIRAL"
        ok &= diag["n_hat"] == 3
        ok &= diag["coherence_C"] < dec.C_LO
        chis.append(cands[0].evidence.get("chirality"))
    ok &= chis[0] == +1 and chis[1] == -1     # convention §7 note 3
    # standing mode must not be flagged spiral
    cands, diag = dec.decode_image(_sign_image(3, 1), return_diagnostics=True)
    ok &= diag["route"] == "DISK" and diag["coherence_C"] >= dec.C_LO
    # rings with 3-fold amplitude wobble: same A(n), must not be spiral (V6)
    res = 384
    yy, xx = np.mgrid[0:res, 0:res]
    c = (res - 1) / 2.0
    rr = np.hypot(xx - c, yy - c) / (c * 0.97)
    th = np.arctan2(yy - c, xx - c)
    wob = sum((1 + 0.6 * np.cos(3 * th))
              * np.exp(-((rr - rho) ** 2) / (2 * 0.012 ** 2))
              for rho in (0.35, 0.6, 0.85))
    _, diag = dec.decode_image(wob, return_diagnostics=True)
    ok &= diag["route"] != "SPIRAL" and diag.get("coherence_C", 0) > dec.C_LO
    check("decode: spiral chirality (V5) + ring/spiral conflation guard (V6)", ok,
          f"chis={chis}")


