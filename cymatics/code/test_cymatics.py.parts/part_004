def test_js_engine_parity():
    """v2 cross-validation: the ported JS engine (assets/cymatics_engine.js)
    agrees with Python/scipy — Bessel zeros (both rims), Lorentzian weights,
    sand-sim determinism, ladder anchors.  Skipped cleanly if node is absent."""
    import json
    import os
    import shutil
    import subprocess
    import tempfile

    if shutil.which("node") is None:
        check("v2: JS engine parity (node) + sand determinism", True,
              "skipped — node not on PATH")
        return
    js = os.path.abspath(os.path.join(
        os.path.dirname(__file__), "..", "..", "app", "assets",
        "cymatics_engine.js"))
    with tempfile.NamedTemporaryFile("w", suffix=".cjs", delete=False) as fh:
        fh.write(_JS_PARITY_DRIVER)
        driver = fh.name
    try:
        out = subprocess.run(["node", driver, js], capture_output=True,
                             text=True, timeout=60)
        if out.returncode != 0:
            check("v2: JS engine parity (node) + sand determinism", False,
                  out.stderr.strip()[:300])
            return
        r = json.loads(out.stdout)
    finally:
        os.unlink(driver)

    ok = abs(r["besselJ_at_z01"]) < 1e-9 and abs(r["besselJ_at_z32"]) < 1e-9
    # hardcoded JS tables (A&S, 10 decimals) vs scipy exact — tol 5e-9
    for js_z, py_z in zip(r["freeZeros"],
                          [cym.bessel_derivative_zero(0, 1),
                           cym.bessel_derivative_zero(1, 1),
                           cym.bessel_derivative_zero(2, 1),
                           cym.bessel_derivative_zero(1, 2),
                           cym.bessel_derivative_zero(5, 3)]):
        ok &= abs(js_z - py_z) < 5e-9
    for js_z, py_z in zip(r["clampedZeros"],
                          [cym.bessel_zero(0, 1), cym.bessel_zero(3, 2)]):
        ok &= abs(js_z - py_z) < 5e-9
    # Lorentzian weights parity (same formula both sides)
    py_w = [x["weight"] for x in cym.lorentzian_superposition(
        [(0, 1, 255.2), (1, 1, 406.5), (2, 1, 544.8)], 406.5, gamma=5.0)]
    for a, b in zip(sorted(r["lorentzian"], reverse=True),
                    sorted(py_w, reverse=True)):
        ok &= abs(a - b) < 1e-12
    # sand determinism: same seed → identical state; different seed → differs
    ok &= r["sandSameSeedSame"] and r["sandDiffSeedDiffers"]
    # ladder anchors: 180 Hz → (1,0) at exactly 0 cents on the steel square;
    # 110 Hz → free-rim (0,1) disc mode at 0 cents
    ok &= (r["ladder180"]["n"], r["ladder180"]["m"]) in ((0, 1), (1, 0))
    ok &= abs(r["ladder180"]["cents"]) < 1e-6
    ok &= (r["ladderDisc"]["m"], r["ladderDisc"]["s"]) == (0, 1)
    ok &= abs(r["ladderDisc"]["cents"]) < 1e-6
    check("v2: JS engine parity (node) + sand determinism", ok)


