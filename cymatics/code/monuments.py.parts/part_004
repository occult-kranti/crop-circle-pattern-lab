lished / n/a",
        "geometry_class": mon["geometry_class"],
        "rt60": mon.get("rt60_measured_s") or mon.get("rt60_modeled_s") or "not published",
        "top_modes_modeled": top3,
        "measured_resonances": meas,
        "measured_unverified": mon.get("measured_unverified", []),
        "vocal_range_overlap": _vocal_overlap(all_hz),
        "sub_20hz_content": {"frequencies_hz": sub20,
                             "label": "below pitch perception — felt as pressure/vibration, not heard"},
        "intra_chamber_beats": _intra_beats(all_hz),
        "provenance_summary": f"{n_meas} MEASURED entries, {n_mod} MODELED values, 0 DECODED links",
        "mode_space": mode_space,
        "caveats": mon.get("caveats", []),
    }
    if mon.get("measured_unverified"):
        card["provenance_summary"] += (f", +{len(mon['measured_unverified'])} "
                                       "MEASURED-unverified popular claims (tier 3, flag only)")
    return card


def build_monument(mon):
    """Full analysis record for one monument entry."""
    modeled = _modeled_modes(mon)
    mode_space = _mode_space(mon, modeled)
    card = sonic_signature_card(mon, modeled, mode_space)
    return {
        "id": mon["id"], "site": mon["site"], "chamber": mon["chamber"],
        "n_fold": mon["n_fold"], "key_ratio": mon["key_ratio"],
        "geometry_class": mon["geometry_class"],
        "dims": mon.get("dims_m"), "dims_status": mon.get("dims_status"),
        "modes_modeled": modeled,
        "measured": mon["measured"],
        "mode_space": mode_space,
        "signature_card": card,
    }


