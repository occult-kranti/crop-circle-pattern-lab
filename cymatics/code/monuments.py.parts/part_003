def _vocal_overlap(freqs):
    def in_rng(f, rng):
        return isinstance(f, (int, float)) and rng[0] <= f <= rng[1]
    male = [f for f in freqs if in_rng(f, MALE_RANGE)]
    female = [f for f in freqs if in_rng(f, FEMALE_RANGE)]
    return {"male_82_330_hz": male, "female_165_523_hz": female}


def _intra_beats(freqs, top=3):
    """Intra-chamber beats: top mode-pair Δf + perceptual category (card spec)."""
    fs = sorted(f for f in freqs if isinstance(f, (int, float)))
    pairs = []
    for i in range(len(fs)):
        for j in range(i + 1, len(fs)):
            df = fs[j] - fs[i]
            pairs.append({"f1_hz": round(fs[i], 2), "f2_hz": round(fs[j], 2),
                          "delta_f_hz": round(df, 2),
                          "category": notes.beat_category(df)})
    pairs.sort(key=lambda p: p["delta_f_hz"])
    return pairs[:top]


