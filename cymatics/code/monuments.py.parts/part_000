def room_mode_freq(nx, ny, nz, Lx, Ly, Lz, c=C_AIR):
    """Rigid rectangular box mode (physics spec §0): f=(c/2)*sqrt((nx/Lx)^2+...)."""
    return (c / 2.0) * math.sqrt((nx / Lx) ** 2 + (ny / Ly) ** 2 + (nz / Lz) ** 2)


def room_modes(Lx, Ly, Lz, n_max=10, f_max=400.0, c=C_AIR):
    """All box modes with indices <= n_max and f <= f_max, sorted by frequency.

    Returns list of dicts: indices, type (axial/tangential/oblique), f_hz,
    membrane analog (physics spec §3 convention).
    """
    out = []
    for nx in range(0, n_max + 1):
        for ny in range(0, n_max + 1):
            for nz in range(0, n_max + 1):
                if nx == ny == nz == 0:
                    continue
                f = room_mode_freq(nx, ny, nz, Lx, Ly, Lz, c)
                if f > f_max:
                    continue
                k = sum(1 for v in (nx, ny, nz) if v > 0)
                mtype = {1: "axial", 2: "tangential", 3: "oblique"}[k]
                out.append({
                    "indices": [nx, ny, nz],
                    "type": mtype,
                    "f_hz": round(f, 2),
                    "membrane_analog": membrane_analog(nx, ny, nz),
                    "provenance": "MODELED",
                    "model": "rigid-box (c/2)*sqrt((nx/Lx)^2+(ny/Ly)^2+(nz/Lz)^2)",
                })
    out.sort(key=lambda d: (d["f_hz"], d["indices"]))
    return out


def membrane_analog(nx, ny, nz):
    """Box mode -> leading circular-membrane harmonic (physics spec §3 convention).

    Heuristic by symmetry class, NOT an isomorphism: a box mode is a superposition
    of circular harmonics; this returns the leading component. Returns (m, n) with
    m = azimuthal order, n = radial order, or a string flag for mixed classes.
    """
    idx = (nx, ny, nz)
    nonzero = sorted((v for v in idx if v > 0), reverse=True)
    n_nonzero = len(nonzero)
    if n_nonzero == 1:                      # axial (n,0,0)
        n = nonzero[0]
        if n == 1:
            return [1, 1]                   # dipole
        if n in (2, 3):
            return [1, 2]
        if n in (4, 5):
            return [1, 3]
        return [1, max(2, math.ceil(n / 2))]  # spec: (1, ceil(n/2)+...) extrapolation
    if n_nonzero == 2:                      # tangential
        a, b = nonzero
        if (a, b) == (1, 1):
            return [2, 1]                   # quadrupole
        if (a, b) == (2, 1):
            return [3, 1]
        if (a, b) == (2, 2):
            return "mixed (0,2)+(4,1)"
        return [max(a, b), min(a, b)]       # fallback: crossed-plane grid
    # oblique
    if tuple(sorted(idx)) == (1, 1, 1):
        return [3, 1]                       # octupole class
    return "mixed oblique"


def helmholtz(A_mouth, V_cavity, L_eff=None, c=C_AIR):
    """Helmholtz resonator f = (c/2pi)*sqrt(A/(V*L_eff)).

    If L_eff is None, uses the physics-spec §1b end-corrected estimate
    L_eff = 1.46*sqrt(A/pi) (mouth treated as unflanged circular opening).
    """
    if L_eff is None:
        L_eff = 1.46 * math.sqrt(A_mouth / math.pi)
    return (c / (2.0 * math.pi)) * math.sqrt(A_mouth / (V_cavity * L_eff))


def quarter_wave_open(depth, end_correction=True, A_open=None, c=C_AIR):
    """Open-top quarter-wave resonance (physics spec §1b sarcophagus vertical mode).

    f = c / (4*(D + 0.61*sqrt(A/pi))) with flanged-pipe end correction;
    raw c/(4D) if end_correction=False.
    """
    if end_correction and A_open:
        return c / (4.0 * (depth + 0.61 * math.sqrt(A_open / math.pi)))
    return c / (4.0 * depth)


def chirp_comb(tread, riser, theta_deg=45.0, c=C_AIR):
    """Reflection-grating comb for a periodic staircase (physics spec §1f).

    tau = (tread*cos(theta) + riser*sin(theta))/c ; comb peaks at f = 1/tau.
    Returns (tau_ms, f_hz).
    """
    th = math.radians(theta_deg)
    tau = (tread * math.cos(th) + riser * math.sin(th)) / c
    return tau * 1e3, 1.0 / tau


def comb_scale(spacing, c=C_AIR):
    """First Bragg/stop-band scale of a periodic scatterer array: f ~ c/(2d)."""
    return c / (2.0 * spacing)


def effective_radius(A_floor):
    """Effective membrane radius R = sqrt(A_floor/pi) (physics spec §3 table)."""
    return math.sqrt(A_floor / math.pi)


def membrane_f01(R, c=C_AIR):
    """Fundamental of a clamped circular membrane of radius R: f01 = z01*c/(2*pi*R)."""
    return BESSEL_TABLE[0][0] * c / (2.0 * math.pi * R)


def schroeder_freq(rt60, volume):
    """Schroeder frequency f_s ~ 2000*sqrt(RT60/V) (physics spec §0)."""
    return 2000.0 * math.sqrt(rt60 / volume)


def _note(f_hz):
    """freq_to_note wrapper returning compact {label, cents, band}."""
    n = notes.freq_to_note(f_hz)
    return {"note": n["label"], "cents": round(n["cents"], 1), "band": n["band"]}


