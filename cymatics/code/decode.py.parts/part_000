# ==========================================================================
# Scoring / confidence helpers (math spec §3)
# ==========================================================================

def _normalize_scores(raw, k=3):
    """Normalize raw S values over the returned top-k (math spec §3.1).

    Raw scores contain a negative log-prior and node penalties, so they are
    shifted positive (relative to the weakest hypothesis considered) before
    normalization: score(μ) = S'(μ)/Σ_top-k S'.  `raw` must be sorted in
    descending order; the first k normalized scores are returned.
    """
    raw = np.asarray(raw, dtype=float)
    if raw.size == 0:
        return raw
    span = raw.max() - raw.min()
    shift = raw.min() - max(0.05 * span, 1e-6)
    sp = np.maximum(raw - shift, 1e-9)
    top = sp[:k]
    return top / top.sum()


def _classify(score, gap, fisher_p=None, eps_node=None, forced_low=False,
              structural=False):
    """Confidence classes (math spec §3.3).

    HIGH:   top ≥ 0.6 AND gap ≥ 0.15 AND p_Fisher < 1e-3 AND ε_node < 5%
    MEDIUM: top ≥ 0.4 AND gap ≥ 0.05, or single-estimate (structural) paths
    LOW:    everything else; forced for fractal/broadband and >200 features
    """
    if forced_low:
        return "LOW"
    if structural:
        return "MEDIUM"
    if (score >= 0.6 and gap >= 0.15
            and (fisher_p is None or fisher_p < 1e-3)
            and (eps_node is None or eps_node < 0.05)):
        return "HIGH"
    if score >= 0.4 and gap >= 0.05:
        return "MEDIUM"
    return "LOW"


def _divisors(k):
    return [d for d in range(1, k) if k % d == 0]


def _bessel_coincidences(n, m, width=0.02):
    """Bessel near-coincidences α_{n,m} ≈ α_{n',m'} (math spec §3.2.6)."""
    z = bessel_zero(n, m)
    out = []
    for nn in range(0, 9):
        for mm in range(1, 7):
            if (nn, mm) == (n, m):
                continue
            if abs(bessel_zero(nn, mm) - z) / z < width:
                out.append((nn, mm))
    return out


