        n_peak = n_hat
        for d in range(1, n_peak):
            if n_peak % d == 0 and A[d] > 0.1 * A[n_peak]:
                n_hat = d
                break
        fisher_p, g = _fisher_p(A, n_hat)
        diag["recentered"] = (float(cx), float(cy))

    C, slope, slope_r2, D = _phase_coherence(P, r, n_hat)
    diag.update(route=None, n_hat=n_hat, fisher_p=fisher_p, fisher_g=g,
                coherence_C=round(C, 3), slope=round(slope, 3),
                slope_R2=round(slope_r2, 3), noise_floor_tau=float(tau))
    if n_hat != 1 and A[1] > A[n_hat] / 2:
