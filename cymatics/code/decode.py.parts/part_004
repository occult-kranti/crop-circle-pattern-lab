                best_c, best_con = (cx + dcx, cy + dcy), cval
    if best_c != (cx, cy):
        cx, cy = best_c
        P, r = _polar_resample(img, cx, cy, R, N_r, N_theta)
        A = _angular_spectrum(P, r)
        tau = _noise_floor(A)
