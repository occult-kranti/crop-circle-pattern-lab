=max(best[1], 0.0), eps_node=best[2],
                            R_fit=best[3]))
    return results, measured


def _comb_pitch(profile, d_min=2.0, d_max=None, k_max=8):
    """Cell pitch from the comb spectrum of an edge-map axis profile.

    score(d) = mean_k S(k/d) · d^{−1/2}   (subharmonic penalty, §1.5/§7 n.4)
    """
    N = profile.size
    if d_max is None:
        d_max = N / 3.0
    x = profile - uniform_filter1d(profile.astype(float),
                                   size=max(int(N // 6), 3))
    x = x * np.hanning(N)
    S = np.abs(np.fft.rfft(x))
    freqs = np.fft.rfftfreq(N)          # cycles per pixel
    f_nyq = 0.5

    def score(d):
        # Σ_k S(k/d) · d^{−1/2}: the sum (not the mean) is what makes the
        # d^{−1/2} subharmonic penalty work — with a mean, subharmonics
        # d/2 of the true pitch score equally well (their teeth all land
        # on true comb teeth) and win through the weaker penalty.
        K = max(1, min(int(d * f_nyq), k_max))
        ks = np.arange(1, K + 1)
        vals = np.interp(ks / d, freqs, S)
        return vals.sum() * d ** -0.5

    ds = np.arange(d_min, d_max, 0.25)
    scores = np.array([score(d) for d in ds])
    i = int(np.argmax(scores))
    strength = scores[i] / max(np.median(scores), 1e-12)
    # refine around the argmax
    fine = np.arange(max(d_min, ds[i] - 0.3), ds[i] + 0.31, 0.05)
    fs = np.array([score(d) for d in fine])
    d_best = float(fine[int(np.argmax(fs))])
    return d_best, float(strength), float(scores[i])


def _grid_decode(img, mask):
    """GRID path (math spec §1.5): 2-D Cartesian FFT → square-plate modes."""
    gx = np.abs(np.gradient(img, axis=1))
    gy = np.abs(np.gradient(img, axis=0))
    E = gx + gy                                # edge map (§7 note 4)
    col = E.sum(axis=0)
    row = E.sum(axis=1)
    dx, sx, combx = _comb_pitch(col)
    dy, sy, comby = _comb_pitch(row)
    ys, xs = np.nonzero(mask)
    W = xs.max() - xs.min() + 1 if xs.size else img.shape[1]
    H = ys.max() - ys.min() + 1 if ys.size else img.shape[0]
    p_hat = max(int(round(W / dx)), 1)
    q_hat = max(int(round(H / dy)), 1)
    # lattice peak sharpness of the windowed 2-D FFT
    F = np.abs(np.fft.fft2(img * np.outer(np.hanning(img.shape[0]),
                                          np.hanning(img.shape[1]))))
    G = F.max() / max(np.median(F), 1e-12)
    ev = dict(route="GRID", cell_pitch_px=(round(dx, 2), round(dy, 2)),
              comb_strength=(round(sx, 2), round(sy, 2)), G=round(float(G), 1),
              cells=(p_hat, q_hat),
              note="cell pitch from the comb spectrum of the edge map "
                   "(§7 note 4); if the bits encode arbitrary data the "
                   "(p,q) mode is the *container* and the content is "
                   "non-modal information")
    raw = []
    s_ang = min(1.0, (min(sx, sy) - 1.0) / 8.0)
    S_top = (W_ANG * max(s_ang, 0.3) + W_PRIOR * math.log(CLASS_PRIORS["square"]))
    raw.append([p_hat, q_hat, "square", S_top, dict(ev)])
    if p_hat == q_hat:
        raw.append([q_hat, p_hat, "square", S_top,
                    dict(ev, note="(p,q)↔(q,p) exact degeneracy (a=b)")])
    raw.append([max(p_hat - 1, 1), q_hat, "square", 0.4 * S_top,
                dict(ev, note="±1 cell-count alias")])
    raw.append([p_hat, max(q_hat - 1, 1), "square", 0.35 * S_top,
                dict(ev, note="±1 cell-count alias")])
    raw.sort(key=lambda r: -r[3])
    scores = _normalize_scores([r[3] for r in raw])
    out = []
    for i, (p, q, model, _s, evd) in enumerate(raw[:3]):
        gap = scores[i] - (scores[i + 1] if i + 1 < len(scores) else 0.0)
        conf = _classify(scores[i], max(gap, 0.05))   # geometric confidence
        evd = dict(evd)
        evd["freq_ratio"] = math.hypot(p, q) / math.sqrt(2.0)
        evd["confidence_note"] = ("geometric count HIGH; physical (modal) "
                                  "interpretation LOW")
        out.append(ModeCandidate(n=p, m=q, model="square",
                                 score=float(scores[i]), confidence=conf,
                                 evidence=evd))
    return out


def _logpolar(img, cx, cy, r_min, R, N_u=256, N_theta=512):
    """L(u_k, θ_j) = I(c + e^{u_k}(cosθ, sinθ))  (math spec §1.4.1)."""
    u = np.linspace(math.log(r_min), math.log(R), N_u)
    th = 2.0 * np.pi * np.arange(N_theta) / N_theta
    UU, TT = np.meshgrid(u, th, indexing="ij")
    xs = cx + np.exp(UU) * np.cos(TT)
    ys = cy + np.exp(UU) * np.sin(TT)
    return map_coordinates(img, [ys, xs], order=1, mode="constant", cval=0.0)


def _spiral_decode(img, cx, cy, R, P, r, n_hat, C, slope, slope_r2, A, tau):
    """SPIRAL path (math spec §1.4): log-polar FFT, arm count, chirality.

    The 2-D FFT peak (ν_u, ν_θ) of the log-polar unwrap gives n̂ = ν_θ and
    b̂ = ν_θ·Δu/(2π·ν_u), where Δu = ln(R/r_min) is the u-range of the
    resample (the spec's b̂ = ν_θ/ν_u assumes u normalized to a 2π span).
    Cross-checked against the radial phase slope |dφ/d ln r| = n̂/b
    (§7 V5: measured 7.38 vs theory 7.5).  Chirality convention (§7 note 3):
    χ := −sign(dφ/d ln r) with demodulation kernel e^{−inθ}; χ = +1 =
    right-handed (radius grows clockwise).  Chirality is metadata and never
    affects f for isotropic resonators (§4.3).
    """
    r_min = max(3.0, 0.05 * R)
    L = _logpolar(img, cx, cy, r_min, R)
    Nu, Nt = L.shape
    u_range = math.log(R / r_min)
    W2 = np.outer(np.hanning(Nu), np.hanning(Nt))
    F = np.fft.fftshift(np.abs(np.fft.fft2(L * W2)))
    cu, ct = Nu // 2, Nt // 2
    # peak search restricted to the |ν_θ| = n_hat columns (the arm harmonic),
    # ν_u ≠ 0 (ν_u = 0 ⇒ concentric rings, not a spiral — §1.4.2)
    best = None
    for sgn in (+1, -1):
        col = ct + sgn * n_hat
        if col < 0 or col >= Nt:
            continue
        for iu in range(1, Nu // 2):
            for iu_s in (cu + iu, cu - iu):
                if best is None or F[iu_s, col] > best[0]:
                    best = (F[iu_s, col], iu_s - cu, sgn * n_hat)
    nu_u, nu_th = (best[1], best[2]) if best else (0, n_hat)
    n_arm = n_hat
    b_fft = (abs(nu_th) * u_range / (2.0 * np.pi * abs(nu_u))
             if nu_u != 0 else np.inf)
    b_slope = n_arm / abs(slope) if abs(slope) > 1e-9 else np.inf
    b_hat = b_slope if slope_r2 > 0.5 else b_fft
    gamma = math.degrees(math.atan(1.0 / b_hat)) if np.isfinite(b_hat) else 0.0
    # chirality convention (§7 note 3): χ := −sign(dφ/d ln r), kernel e^{−inθ}
    chirality = -int(np.sign(slope)) if slope != 0 else 0
    # beads per arm (§1.4.3): bead glyphs are sparse dot fields — count
    # connected components, normalizing merged clusters by the single-dot
    # area.  Approximate when dots overlap; honesty-noted as a
    # *construction count*, never a modal radial order (§4.4).
    beads = _bead_count(img, n_arm)
    ev = dict(route="SPIRAL", arms=n_arm, coherence_C=round(C, 3),
              slope_dphi_dlnr=round(slope, 3), slope_R2=round(slope_r2, 3),
              fft_peak=(int(nu_u), int(nu_th)),
              pitch_b=round(b_hat, 3), pitch_b_fft=round(b_fft, 3),
              pitch_angle_deg=round(gamma, 1), chirality=chirality,
              note="C ≪ 1 with linear φ(ln r) → traveling wave / geometric "
                   "spiral (§1.4.4); chirality is metadata, never affects f")
    raw = []
    S_modal = (W_ANG * (A[n_arm] ** 2 / max((A[1:A.size // 2] ** 2).sum(), 1e-300))
               + W_PRIOR * math.log(CLASS_PRIORS["spiral"]))
    if beads and beads > 6:
        # §4.4: construction count, sub-resolution for modal purposes
        raw.append([n_arm, beads, "membrane", 0.55 * S_modal + 0.4,
                    dict(ev, beads_per_arm=beads,
                         note="construction count, not a mode (§4.4) — LOW "
                              "confidence for any physical frequency")])
    raw.append([n_arm, 1, "membrane", S_modal,
                dict(ev, note="modal candidate: azimuthal order robust (§4.4)")])
    raw.append([n_arm, 2, "membrane", 0.7 * S_modal, dict(ev)])
    raw.sort(key=lambda rr: -rr[3])
    scores = _normalize_scores([rr[3] for rr in raw])
    out = []
    for i, (n, m, model, _s, evd) in enumerate(raw[:3]):
        forced_low = "construction count" in evd.get("note", "")
        gap = scores[i] - (scores[i + 1] if i + 1 < len(scores) else 0.0)
        conf = _classify(scores[i], gap, forced_low=forced_low)
        evd = dict(evd)
        if m:
            evd["freq_ratio"] = bessel_zero(n, m) / bessel_zero(0, 1)
        out.append(ModeCandidate(n=n, m=m, model=model, score=float(scores[i]),
                                 confidence=conf, evidence=evd))
    return out


