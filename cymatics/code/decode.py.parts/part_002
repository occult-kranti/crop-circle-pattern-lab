def _otsu(img):
    """Otsu threshold (math spec §1.1 step 1)."""
    vals = img.ravel()
    hist, edges = np.histogram(vals, bins=256)
    centers = 0.5 * (edges[:-1] + edges[1:])
    w = hist.astype(float)
    w_sum = w.sum()
    if w_sum == 0:
        return 0.0
    p = w / w_sum
    omega = np.cumsum(p)
    mu = np.cumsum(p * centers)
    mu_t = mu[-1]
    sigma_b2 = (mu_t * omega - mu) ** 2 / np.maximum(omega * (1 - omega), 1e-12)
    return float(centers[np.argmax(sigma_b2)])


def _segment(img):
    """Segment glyph mask M (math spec §1.1.1).

    Sparse glyphs (nodal lines, dots, sign maps on a zero background) are
    thresholded against the background; dense images use Otsu.
    """
    amax = np.abs(img).max()
    if amax == 0:
        raise ValueError("blank image")
    mask = np.abs(img) > 0.02 * amax
    if mask.mean() > 0.95:
        thr = _otsu(np.abs(img))
        mask = np.abs(img) > thr
    return mask


def _center_radius(mask):
    """Moment centroid + 95th-percentile radius (math spec §1.1.2–3)."""
    ys, xs = np.nonzero(mask)
    if xs.size == 0:
        raise ValueError("empty glyph mask")
    cx = xs.mean()
    cy = ys.mean()
    d = np.hypot(xs - cx, ys - cy)
    R = float(np.percentile(d, 95))
    if 2 * R < 10:
        raise ValueError("insufficient resolution: pattern < 10 px across "
                         "(physics spec §3.10 guard rail)")
    return cx, cy, R


def _polar_resample(img, cx, cy, R, N_r, N_theta):
    """P(r_k, θ_j) = I(c + r_k·(cosθ, sinθ))  (math spec §1.2)."""
    r = (np.arange(N_r) + 0.5) * R / N_r
    th = 2.0 * np.pi * np.arange(N_theta) / N_theta
    RR, TT = np.meshgrid(r, th, indexing="ij")
    xs = cx + RR * np.cos(TT)
    ys = cy + RR * np.sin(TT)
    P = map_coordinates(img, [ys, xs], order=1, mode="constant", cval=0.0)
    return P, r


def _angular_spectrum(P, r):
    """A(n) = Σ_k | FFT_θ{ w(r_k)·P(r_k,·) }(n) |,  w = r (area weight).

    Power-summed over radius, NOT coherently integrated (math spec §1.2,
    §7 note 1): coherent radial integration mis-ranks orders across
    nodal-circle sign flips.
    """
    F = np.fft.fft(P * r[:, None], axis=1)
    return np.abs(F).sum(axis=0)


def _noise_floor(A, n_min=8):
    """τ = median(A[n≥8]) + 3·MAD  (math spec §4.6)."""
    tail = A[n_min: A.size // 2]
    med = np.median(tail)
    mad = np.median(np.abs(tail - med))
    return med + 3.0 * mad


def _fisher_p(A, n_hat):
    """Fisher g-test p-value: p ≈ N·(1−g)^{N−1}  (math spec §1.2)."""
    N = A.size // 2
    power = A[1:N] ** 2
    g = power[n_hat - 1] / max(power.sum(), 1e-300)
    g = min(g, 1.0)
    return float(N * (1.0 - g) ** max(N - 1, 0)), g


def _phase_coherence(P, r, n_hat):
    """Radial phase coherence C (math spec §1.4.4).

        C = | Σ_k w(r_k) e^{iφ(r_k)} | / Σ_k w(r_k),
        φ(r_k) = arg Σ_j P e^{−2πi n̂ j/N_θ}

    C ≈ 1 → standing mode; C ≪ 1 with linear φ(ln r) → spiral/traveling wave.
    Also returns the fitted slope dφ/d ln r and its R².
    """
    th = 2.0 * np.pi * np.arange(P.shape[1]) / P.shape[1]
    kern = np.exp(-1j * n_hat * th)
    D = P @ kern                       # complex demodulate per radius
    phase = np.angle(D)
    w = r * np.abs(D)
    w = np.maximum(w, 1e-12)
    C = abs(np.sum(w * np.exp(1j * phase))) / np.sum(w)
    # linear fit of unwrapped phase vs ln r (spiral pitch test)
    good = np.abs(D) > 0.1 * np.abs(D).max()
    if good.sum() < 8:
        return C, 0.0, 0.0, D
    u = np.log(r[good])
    ph = np.unwrap(phase[good])
    A = np.vstack([u, np.ones_like(u)]).T
    coef, *_ = np.linalg.lstsq(A, ph, rcond=None)
    resid = ph - A @ coef
    ss_res = float(resid @ resid)
    ss_tot = float(((ph - ph.mean()) ** 2).sum())
    r2 = 1.0 - ss_res / max(ss_tot, 1e-12)
    return float(C), float(coef[0]), r2, D


def _match_nodes(measured, n, m):
    """Match measured nodal radii to z_{n,j}/z_{n,m} via bipartite assignment.

    Tolerance 0.07 R plus a count-mismatch penalty (math spec §7 note 2).
    Returns ε_node (RMS residual, dimensionless, in units of R).
    """
    expected = nodal_circle_radii(n, m)
    measured = np.asarray(measured, dtype=float)
    n_meas, n_exp = measured.size, expected.size
    if n_exp == 0 and n_meas == 0:
        return 0.0
    if n_meas == 0:
        return NODE_TOL * 1.5 * n_exp          # missed every circle
    if n_exp == 0:
        return NODE_TOL * 1.5 * n_meas         # spurious circles
    cost = np.abs(measured[:, None] - expected[None, :])
    ri, ci = linear_sum_assignment(cost)
    matched = [cost[i, j] for i, j in zip(ri, ci) if cost[i, j] <= NODE_TOL]
    unmatched = n_meas + n_exp - 2 * len(matched)
    ss = sum(c * c for c in matched) + unmatched * (NODE_TOL * 1.5) ** 2
    count_penalty = 0.05 * abs(n_meas - n_exp)
    return float(np.sqrt(ss / max(n_meas + n_exp, 1)) + count_penalty)


def _nodal_minima(profile, r, R):
    """Interior minima of a normalized radial profile (math spec §1.3b).

    On thresholded/binary images the envelope is flattened and nodal-circle
    detection is the robust radial-order estimator (§7 note 2).
    """
    x = profile / max(np.abs(profile).max(), 1e-12)
    xs = uniform_filter1d(x, size=5)
    interior = (r / R > 0.08) & (r / R < 0.97)
    idx, _ = find_peaks(-xs[interior], prominence=0.08)
    r_interior = r[interior]
    radii = r_interior[idx]
    depths = 1.0 - xs[interior][idx]
    keep = depths > 0.15                 # a real node dips toward zero
    return radii[keep] / R


def _zero_crossings(profile, r, R):
    """Sub-sample zero crossings of a signed radial profile, interior only.

    On signed data (sign maps / continuous amplitude) a nodal circle is a
    π phase flip of the demodulate, i.e. a zero crossing of its projection
    onto the dominant phase — this is the signed-data form of the §1.3b
    nodal-circle detector (§7 note 2).
    """
    x = uniform_filter1d(profile.astype(float), size=3)
    interior = (r / R > 0.05) & (r / R < 0.97)
    xi, ri = x[interior], r[interior]
    sgn = np.sign(xi)
    crossings = []
    for i in np.nonzero(np.diff(sgn) != 0)[0]:
        # linear interpolation of the crossing position
        x0, x1 = xi[i], xi[i + 1]
        frac = abs(x0) / max(abs(x0) + abs(x1), 1e-12)
        crossings.append((ri[i] + frac * (ri[i + 1] - ri[i])) / R)
    return np.array(crossings)


