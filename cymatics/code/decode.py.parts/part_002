def _factor_pairs(N):
    pairs = []
    for a in range(1, int(math.sqrt(N)) + 1):
        if N % a == 0:
            pairs.append((a, N // a))
    return pairs


def _is_prime(k):
    if k < 2:
        return False
    for d in range(2, int(math.sqrt(k)) + 1):
        if k % d == 0:
            return False
    return True


