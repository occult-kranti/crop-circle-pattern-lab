eresting"]] == [r["D"] for r in res2["interesting"]])
    checks.append(("U1 determinism (run twice, identical matrix + null + verdicts)", det))

    # U2 symmetry-space sanity (task spec): 6 vs 12 ~ small (octave equivalent),
    # 6 vs 24 clearly larger
    d612 = d_sym(6, 12)
    d624 = d_sym(6, 24)
    checks.append((f"U2 d_sym octave sanity: d(6,12)={d612:.4f} ~ 0 < d(6,24)={d624:.4f}",
                   d612 < 0.05 and d624 > d612 + 0.3))

    # U3 Bonferroni floor: WY rejections must be a superset (§4.6)
    checks.append((f"U3 WY superset of Bonferroni "
                   f"(Bonf {res1['n_bonferroni_pass']} <= WY {res1['n_wy_pass']})",
                   res1["wy_superset_bonferroni"]))

    # U4 within-domain known-similar pilot pair: Koch I vs Koch II snowflakes
    items, pairs = res1["items"], res1["pairs"]
    idx = {it["id"]: it["idx"] for it in items}
    k = pairs.index((min(idx["crop_23"], idx["crop_24"]), max(idx["crop_23"], idx["crop_24"])))
    d_koch = res1["D"][k]
    checks.append((f"U4 within-domain pilot: D(Koch I, Koch II) = {d_koch:.4f} <= 0.2",
                   d_koch <= 0.2))
    return checks


def verdicts_list(res):
    """Short human-readable verdicts: interesting (confirmatory) then candidates."""
    out = []
    for r in res["interesting"]:
        out.append(f"INTERESTING  D={r['D']:.3f}  p={r['p_fwer']:.2e}  q={r['q_fdr']:.3f}  "
                   f"z={r['robust_z']:.1f}  groups={r['n_groups_agree']}/4  "
                   f"{r['a']} <-> {r['b']}  [{r['domains'][0]}x{r['domains'][1]}]")
    for r in res["candidates"][:20]:
        out.append(f"candidate    D={r['D']:.3f}  p={r['p_fwer']:.2e}  q={r['q_fdr']:.3f}  "
                   f"(FDR only, exploratory)  {r['a']} <-> {r['b']}")
    if not out:
        out.append("No cross-domain pair passes the pre-registered interesting criterion.")
    return out


