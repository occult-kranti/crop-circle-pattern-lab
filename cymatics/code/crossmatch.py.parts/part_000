def encode_ratio_sig(ratios, sigma=SIGMA_RATIO):
    """Soft membership vs canonical constants with 2^k / phi^k octave folding (§2.3)."""
    v = np.zeros(6)
    for r in ratios:
        folds = [r * 2.0 ** k for k in (-1, 0, 1)] + [r * PHI ** k for k in (-1, 0, 1)]
        for rf in folds:
            v = np.maximum(v, np.exp(-(np.log(rf) - np.log(CANON)) ** 2 / (2 * sigma ** 2)))
    return v


def analytic_radial_signature(glyph, n_theta=1024):
    """Radial signature s(theta) = max silhouette radius along ray theta (§2.4 step 1).

    Our glyph set is star-shaped by construction, so the ray-cast maximum equals
    the analytic boundary exactly (no rasterization error, perfectly
    deterministic). glyph kinds:
      ('circle',)                 plain circle / concentric rings / INF
      ('rosette', n, amp)         n-fold petal boundary r = R*(1-amp+amp*cos(n*theta))
      ('rect', aspect)            rectangle, aspect = short/long <= 1
    """
    th = np.linspace(0.0, 2.0 * np.pi, n_theta, endpoint=False)
    kind = glyph[0]
    if kind == "circle":
        return np.ones(n_theta)
    if kind == "rosette":
        _, n, amp = glyph
        return (1.0 - amp) + amp * np.cos(n * th)
    if kind == "rect":
        aspect = glyph[1]
        c, s = np.abs(np.cos(th)), np.abs(np.sin(th))
        # distance from center to rectangle boundary along theta
        r = np.where(s * 1.0 <= c * aspect,
                     np.where(c > 0, 1.0 / np.maximum(c, 1e-12), np.inf),
                     np.where(s > 0, aspect / np.maximum(s, 1e-12), np.inf))
        return np.clip(r, 0.0, 1.0 / math.cos(math.pi / 4) * 1.0001) / (1.0 / math.cos(math.pi / 4))
    raise ValueError(f"unknown glyph {glyph}")


def fourier_desc(glyph, n_theta=1024, K=32):
    """Rotation/scale/shift-invariant FD from the radial signature (§2.4).

    F_k = |S_k|/S_0 for k=1..K, then unit-normalized (pseudocode in §5).
    """
    s = analytic_radial_signature(glyph, n_theta)
    S = np.fft.fft(s)
    F = np.abs(S[1:K + 1]) / S[0]
    nrm = np.linalg.norm(F)
    return F / nrm if nrm > 0 else F


def choose_glyph(n_fold, is_grid, grid_aspect, rect_aspect):
    """Map discrete features to a procedural star-shaped silhouette glyph.

    Documented simplification: no photographs/renderings exist for most items, so
    silhouettes are procedural proxies (rosette for n-fold, rectangle for boxes
    and grids, circle for INF/0). FD therefore peaks at k = n_fold by construction
    — consistent with the spec's note that the FD pipeline is the measurement
    device that extracts n_fold (§2.4 note). Chirality is carried by the separate
    boolean, FD is magnitude-only (pre-registered default §2.4 step 5).
    """
    if rect_aspect is not None:
        return ("rect", min(1.0, rect_aspect))
    if is_grid:
        return ("rect", min(1.0, grid_aspect if grid_aspect else 1.0))
    if n_fold is None or n_fold in (0, INF):
        return ("circle",)
    return ("rosette", int(n_fold), 0.25)


def j_mode(mode):
    """Eigenvalue analog for a decoded mode: Bessel zero (membrane) or
    sqrt(p^2+q^2) (square model). McMahon fallback per §6.5."""
    n, m = mode["nm"]
    if mode["model"] == "square":
        return math.sqrt(n * n + m * m)
    if n <= 100 and m <= 200:
        try:
            return float(jn_zeros(n, m)[-1])
        except Exception:
            pass
    beta = (n + 2 * m - 0.5) * math.pi / 2.0     # McMahon expansion (§6.5)
    return beta - (4 * n * n - 1) / (8 * beta)


