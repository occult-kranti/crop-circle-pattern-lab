def d_sym(a, b):
    """Log-octave symmetry distance with soft octave equivalence (§2.1)."""
    if a is None or b is None:
        return np.nan
    if a == b:
        return 0.0
    if INF in (a, b) or 0 in (a, b):
        return 1.0                      # INF or radial-null vs anything finite
    r = np.log2(a / b)
    return min(abs(r), abs(r - 1), abs(r + 1)) / D_MAX_SYM


def d_mode(A, B):
    """Mode-space distance (§2.2): per-index harmonic distance + Bessel-zero
    proximity. Raw-Hz branch when both sides carry measured/modeled Hz and at
    least one lacks (n,m) (§2.2 final paragraph)."""
