def _text(*vals):
    return " ".join(str(v) for v in vals if v and str(v) != "nan").lower()


def load_crop_items():
    """60 formations: n_fold from symmetry_orders.csv (authoritative), size from
    crop_circles.csv, modes from the cymatics engine's structural decodes
    (top candidate only; DECODED provenance noted)."""
    so = {}
    with open(os.path.join(CROP_DIR, "symmetry_orders.csv")) as fh:
        for row in csv.DictReader(fh):
            so[int(row["id"])] = row
    cc = {}
    with open(os.path.join(CROP_DIR, "crop_circles.csv")) as fh:
        for row in csv.DictReader(fh):
            cc[int(row["id"])] = row
    decodes = json.load(open(os.path.join(RESULTS_DIR, "decoding_results.json")))["patterns"]
    # decode pattern id -> crop csv id (SPEC.md pattern list vs dataset names)
    decode_to_csv = {1: 10, 2: 12, 3: 16, 4: 21, 5: 23, 6: 30, 7: 32, 8: 33, 9: 42, 10: 51}
    mode_by_csv_id = {}
    for p in decodes:
        top = p["structural_decode"][0]
        mode_by_csv_id[decode_to_csv[p["id"]]] = {
            "nm": (int(top["n"]), int(top["m"])), "model": top["model"],
            "provenance": "DECODED", "confidence": top["confidence"],
            "score": top["score"], "hz": None,
        }
    # documented ratios (sacred-geometry spec §3-4 discipline: integer/documented only)
    ratios_by_id = {29: [np.pi], 42: [np.pi], 26: [2.0], 23: [3.0], 24: [3.0]}
    grid_aspect_by_id = {32: 23.0 / 73.0}      # Arecibo reply grid

    items = []
    for cid in sorted(cc):
        row, srow = cc[cid], so.get(cid, {})
        nf_raw = srow.get("n_fold", "")
        try:
            n_fold = int(float(nf_raw))
        except (TypeError, ValueError):
            n_fold = None
        # spec §1.1: plain circles / concentric rings have FULL continuous
        # rotational symmetry (INF), not the radial-null class 0. The dataset
        # codes them 0.0; remap when the basis text says circle/ring/oval.
        if n_fold == 0 and any(k in _text(srow.get("n_basis"), row.get("geometry"))
                               for k in ("circle", "ring", "oval", "nest")):
            n_fold = INF
        txt = _text(row.get("geometry"), row.get("geometry_family"),
                    srow.get("n_basis"), row.get("name"))
        is_spiral = int(any(k in txt for k in ("spiral", "julia", "galaxy", "helix")))
        is_grid = int(any(k in txt for k in ("grid", "23x73", "chip rect")))
        is_concentric = int(any(k in txt for k in ("ring", "concentric", "mandala")))
        chiral = int(bool(is_spiral) or "ratchet" in txt)
        try:
            size = float(row.get("size_m") or "nan")
        except ValueError:
            size = float("nan")
        items.append({
            "idx": len(items), "domain": "crop", "id": f"crop_{cid:02d}",
            "name": row["name"], "n_fold": n_fold,
            "flags": {"is_spiral": is_spiral, "is_grid": is_grid,
                      "is_concentric": is_concentric, "chiral": chiral},
            "log_size": math.log10(size) if size > 0 else np.nan,
            "mode": mode_by_csv_id.get(cid),
            "ratios": ratios_by_id.get(cid, []),
            "grid_aspect": grid_aspect_by_id.get(cid),
            "rect_aspect": None,
        })
    return items


