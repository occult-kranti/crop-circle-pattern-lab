     return 0.5 * d_index + 0.5 * d_bessel
    ha, hb = ma.get("hz"), mb.get("hz")
    if ha is not None and hb is not None:
        return min(abs(ha - hb) / ((ha + hb) / 2) / T_BESSEL, 1.0)
    return np.nan


def d_ratio(A, B):
    """Euclidean distance of ratio signatures (§2.3); unobserved unless BOTH
    items carry documented ratios (Gower: observed-for-both only; an all-zero
    signature is treated as 'no data', not as 'zero ratios')."""
    if A["ratio_sig"] is None or B["ratio_sig"] is None:
        return np.nan
    return float(np.linalg.norm(A["ratio_sig"] - B["ratio_sig"]) / np.sqrt(6))


def d_fd(A, B):
    if A["fd"] is None or B["fd"] is None:
        return np.nan
    return float(np.linalg.norm(A["fd"] - B["fd"]) / np.sqrt(2))  # unit-norm vectors (§5)


def pair_dist(A, B, size_range):
    """Weighted Gower composite (§2.5). Returns (D, breakdown, n_major_groups)."""
    parts, wts, breakdown = [], [], {}
    d = d_sym(A["n_fold"], B["n_fold"])
    if not np.isnan(d):
        parts.append(d); wts.append(WEIGHTS["n_fold"]); breakdown["n_fold"] = round(d, 4)
    d = d_mode(A, B)
    if not np.isnan(d):
        parts.append(d); wts.append(WEIGHTS["mode"]); breakdown["mode"] = round(d, 4)
    d = d_ratio(A, B)
    if not np.isnan(d):
        parts.append(d); wts.append(WEIGHTS["ratio"]); breakdown["ratio"] = round(d, 4)
    d = d_fd(A, B)
    if not np.isnan(d):
        parts.append(d); wts.append(WEIGHTS["fd"]); breakdown["fd"] = round(d, 4)
    for f in ("is_spiral", "is_grid", "is_concentric", "chiral"):
        d = abs(A["flags"][f] - B["flags"][f])
        parts.append(d); wts.append(WEIGHTS[f]); breakdown[f] = d
    if not (np.isnan(A["log_size"]) or np.isnan(B["log_size"])) and size_range > 0:
        d = abs(A["log_size"] - B["log_size"]) / size_range
        parts.append(d); wts.append(WEIGHTS["log_size"]); breakdown["log_size"] = round(d, 4)
    n_major = sum(1 for g in MAJOR_GROUPS if g in breakdown)
    if not wts:
        return np.nan, breakdown, n_major
    return float(np.dot(parts, wts) / sum(wts)), breakdown, n_major


