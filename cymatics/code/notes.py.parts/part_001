#: Reference resonators from the master spec / presentation spec §4.
RESONATORS = {
    "R1 drumhead 30cm, c=100 m/s": dict(R=0.15, c=100.0),
    "R2 plate 30cm, c_eff≈1000 m/s (crude)": dict(R=0.15, c=1000.0),
    "R3 plate 1m, c_eff≈1000 m/s (crude)": dict(R=0.5, c=1000.0),
}


def reference_resonator_table():
    """f₀₁ for each reference resonator (presentation spec §4 table)."""
    from cymatics import frequency_membrane
    rows = []
    for name, rp in RESONATORS.items():
        f01 = frequency_membrane(0, 1, rp["R"], rp["c"])
        rows.append(dict(resonator=name, a_m=rp["R"], c=rp["c"],
                         f01_hz=round(f01, 1), note=freq_to_note(f01),
                         comment=("Chladni-plate regime; c_eff lumped and "
                                  "mode-dependent — crude estimate"
                                  if "plate" in name else
                                  "physical membrane speeds 50–300 m/s "
                                  "typical")))
    return rows
