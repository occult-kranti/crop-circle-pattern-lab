         freqs[f"({c.n},{c.m})"] = cym.frequency_membrane(
                c.n, c.m, rp["R"], rp["c"])
        elif c.model == "square" and c.m:
            freqs[f"({c.n},{c.m})"] = cym.frequency_square(
                c.n, c.m, 0.30, 1000.0)
    if len(freqs) < 2:
        return None
    return notes.beat_table(freqs, resonator_name="R1 drumhead 30cm")


