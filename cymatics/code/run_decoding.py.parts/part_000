def render_candidate_image(cand, descriptor, res=512):
    """Forward-render a candidate mode/construction to an image array."""
    if cand.model == "square":
        # pure container mode (sign=0: no degenerate partner for a≠b)
        pat = cym.square_pattern(cand.n, cand.m, res=res, sign=0)
        return pat["amplitude"], f"square ({cand.n},{cand.m})"
    if cand.m is not None and cand.m > 6 and descriptor.get("kind") == "spiral":
        return render_spiral_construction(cand.n, cand.m, res=res), \
            f"spiral construction ({cand.n} arms x {cand.m} beads)"
    pat = cym.membrane_pattern(cand.n, max(cand.m or 1, 1), res=res)
    return pat["amplitude"], f"membrane ({cand.n},{max(cand.m or 1, 1)})"


def render_spiral_construction(arms, beads_per_arm, res=512, b=None,
                               chirality=+1):
    """Beads on logarithmic spiral arms (decorative construction, §4.4)."""
    img = np.zeros((res, res))
    yy, xx = np.mgrid[0:res, 0:res]
    c = (res - 1) / 2.0
    R = c * 0.96
    r0 = 0.06 * R
    if b is None:
        # choose b so arms wind ~1.2 turns over the radius range
        b = np.log(R / r0) / (1.2 * 2 * np.pi)
    t_max = np.log(R / r0) / b
    sig = max(1.5, 0.008 * res)
    for a in range(max(arms, 1)):
        for t in np.linspace(0, t_max, max(beads_per_arm, 1)):
            rr = r0 * np.exp(b * t)
            th = chirality * t + 2 * np.pi * a / max(arms, 1)
            img += np.exp(-(((xx - (c + rr * np.cos(th))) ** 2
                             + (yy - (c + rr * np.sin(th))) ** 2)
                            / (2 * sig ** 2)))
    return img


def save_png(img, title, path, subtitle=""):
    fig, ax = plt.subplots(figsize=(5, 5))
    ax.imshow(img, cmap=CMAP, origin="lower")
    ax.set_title(title, fontsize=10)
    if subtitle:
        ax.set_xlabel(subtitle, fontsize=8)
    ax.set_xticks([])
    ax.set_yticks([])
    fig.tight_layout()
    fig.savefig(path, dpi=DPI)
    plt.close(fig)


def make_synthetic_image(pid, res=384):
    """Forward-rendered synthetic glyph for the decode_image demo."""
    if pid == 3:    # Barbury: 3-fold with 1-2 rings → membrane (3,2)
        return np.sign(cym.membrane_pattern(3, 2, res=res)["u"])
    if pid == 6:    # Milk Hill: 6 arms x ~68 beads
        return render_spiral_construction(6, 68, res=res, b=0.15)
    if pid == 7:    # Chilbolton: 23x73 random-bit grid, 6 px cells
        rng = np.random.default_rng(2001)
        bits = rng.integers(0, 2, size=(73, 23))
        return np.kron(bits, np.ones((6, 6))).astype(float)
    raise KeyError(pid)


