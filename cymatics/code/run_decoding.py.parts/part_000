def candidate_acoustics(cand):
    """Ratios (primary) + Hz at reference resonators (secondary), §4."""
    out = dict(freq_ratio=cand.evidence.get("freq_ratio"))
    if cand.model == "membrane" and cand.m:
        hz = {}
        for rname, rp in notes.RESONATORS.items():
            f = cym.frequency_membrane(cand.n, cand.m, rp["R"], rp["c"])
            hz[rname] = dict(f_hz=round(f, 2), note=notes.freq_to_note(f))
        out["hz_at_reference_resonators"] = hz
    elif cand.model == "square" and cand.m:
        # illustrative 30 cm plate, K' = c/(2L), c = 1000 m/s (§1b model i);
        # plate option (ii) rescales by (p²+q²)/√(p²+q²) — tagged.
        f_mem = cym.frequency_square(cand.n, cand.m, 0.30, 1000.0,
                                     dispersion="membrane")
        f_pla = cym.frequency_square(cand.n, cand.m, 0.30, 17.4 * 0.09,
                                     dispersion="plate")
        out["hz_at_reference_resonators"] = {
            "square plate 30cm membrane-model, c=1000 m/s (illustrative)":
                dict(f_hz=round(f_mem, 2), note=notes.freq_to_note(f_mem)),
            "square plate 30cm plate-model, K''=17.4 Hz h=1mm (dispersive!)":
                dict(f_hz=round(f_pla, 2), note=notes.freq_to_note(f_pla)),
        }
        out["dispersion_models"] = ["membrane (i)", "biharmonic plate (ii)"]
    return out


