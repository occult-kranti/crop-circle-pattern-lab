ush({ n: n, m: m, hz: f, weight: 1 / (d * d + g2) });
      }
    }
    raw.sort(function (a, b) { return b.weight - a.weight; });
    var top = raw.slice(0, Math.max(1, limit));
    var sum = 0;
    for (var i = 0; i < top.length; i++) sum += top[i].weight;
    if (!sum) sum = 1;
    return top.map(function (md) {
      return { n: md.n, m: md.m, hz: md.hz, weight: md.weight / sum };
    });
  }

  /** Lorentzian-weighted circular modes near a driving frequency. */
  function drivenCircularModes(hz, plate, gammaHz, maxOrder, limit) {
    if (maxOrder === undefined) maxOrder = 5;
    if (limit === undefined) limit = 6;
    if (!Number.isFinite(hz) || hz <= 0) return [];
    var gamma = Math.max(1e-6, gammaHz !== undefined ? gammaHz : hz * 0.06);
    var g2 = gamma * gamma;
    var raw = [];
    var table = plate.boundary === 'free' ? BESSEL_DERIVATIVE_ZEROS : BESSEL_ZEROS;
    for (var m = 0; m <= Math.min(maxOrder, table.length - 1); m++) {
      var maxS = Math.min(maxOrder, table[m].length);
      for (var s = 1; s <= maxS; s++) {
        var f = circularModeHz(m, s, plate.fundamentalHz, plate.boundary);
        if (f > hz * 4 && raw.length > 0) continue;
        var d = f - hz;
        raw.push({ m: m, s: s, hz: f, weight: 1 / (d * d + g2) });
      }
    }
    raw.sort(function (a, b) { return b.weight - a.weight; });
    var top = raw.slice(0, Math.max(1, limit));
    var sum = 0;
    for (var i = 0; i < top.length; i++) sum += top[i].weight;
    if (!sum) sum = 1;
    return top.map(function (md) {
      return { m: md.m, s: md.s, hz: md.hz, weight: md.weight / sum };
    });
  }

  /**
   * Driven square-plate field: Σ w_nm·sin(nπx)sin(mπy) (simply-supported
   * plate response). max |field| ≤ 1 (weights sum to 1).
   */
  function drivenSquareField(modes) {
    var terms = modes.map(function (md) {
      return { weight: md.weight, nPi: md.n * PI, mPi: md.m * PI };
    });
    return function (x, y) {
      var v = 0;
      for (var i = 0; i < terms.length; i++) {
        var t = terms[i];
        v += t.weight * Math.sin(t.nPi * x) * Math.sin(t.mPi * y);
      }
      return v;
    };
  }

  /** Driven circular-plate field: Σ w_ms·J_m(k_ms·r)·cos(mθ)/norm. */
  function drivenCircularField(modes, boundary) {
    if (boundary === undefined) boundary = 'clamped';
    var terms = modes.map(function (md) {
      return {
        weight: md.weight, m: md.m,
        k: circularWaveNumber(md.m, md.s, boundary),
        norm: circularPlateNorm(md.m, md.s, boundary),
      };
    });
    return function (x, y) {
      var dx = x - 0.5, dy = y - 0.5;
      var r = Math.sqrt(dx * dx + dy * dy) * 2;
      if (r > 1) return 0;
      var theta = Math.atan2(dy, dx);
      var v = 0;
      for (var i = 0; i < terms.length; i++) {
        var t = terms[i];
        v += (t.weight * besselJ(t.m, t.k * r) * Math.cos(t.m * theta)) / t.norm;
      }
      return v;
    };
  }

  CYM.drivenSquareModes = drivenSquareModes;
  CYM.drivenCircularModes = drivenCircularModes;
  CYM.drivenSquareField = drivenSquareField;
  CYM.drivenCircularField = drivenCircularField;

  /* ------------------------------------------------------------------------ */
  /* Sand simulation — particles drift down-gradient of |field| (Euler step)  */
  /* ------------------------------------------------------------------------ */

  /** Uniform random particle layout over the plate domain (seeded). */
  function createSand(count, seed, circular) {
    if (seed === undefined) seed = 1;
    var n = Math.max(0, Math.floor(count));
    var x = new Float64Array(n);
    var y = new Float64Array(n);
    var prng = seedPrng(seed);
    for (var i = 0; i < n; i++) {
      var a, b;
      if (circular) {
        var dx = 0, dy = 0;
        do {
          a = nextRandom(prng); prng = a.state;
          b = nextRandom(prng); prng = b.state;
          dx = a.value - 0.5;
          dy = b.value - 0.5;
        } while (dx * dx + dy * dy > 0.25);
        x[i] = dx + 0.5;
        y[i] = dy + 0.5;
      } else {
        a = nextRandom(prng); prng = a.state;
        b = nextRandom(prng); prng = b.state;
        x[i] = a.value;
        y[i] = b.value;
      }
    }
    return { count: n, x: x, y: y, prng: prng, circular: !!circular };
  }

  /**
   * One Euler step: particles move down the gradient of |field(x,y)| plus a
   * small seeded jitter. Mutates and returns `state` (allocation-free).
   * Deterministic for a given (state, field, dt, opts).
   * opts: {speed=0.35, jitter=0.02, eps=1e-3}.
   */
  function stepParticles(state, field, dt, opts) {
    opts = opts || {};
    var speed = opts.speed !== undefined ? opts.speed : 0.35;
    var jitter = opts.jitter !== undefined ? opts.jitter : 0.02;
    var eps = opts.eps !== undefined ? opts.eps : 1e-3;
    var step = speed * Math.max(0, dt);
    var jig = jitter * Math.sqrt(Math.max(0, dt));
    var inv2e = 1 / (2 * eps);

    for (var i = 0; i < state.count; i++) {
      var px = state.x[i], py = state.y[i];
      var gx = (Math.abs(field(px + eps, py)) - Math.abs(field(px - eps, py))) * inv2e;
      var gy = (Math.abs(field(px, py + eps)) - Math.abs(field(px, py - eps))) * inv2e;
      var glen = Math.sqrt(gx * gx + gy * gy);
      var nx = px, ny = py;
      if (glen > 1e-9) {
        nx -= (gx / glen) * step;
        ny -= (gy / glen) * step;
      }
      if (jig > 0) {
        var a = nextRandom(state.prng); state.prng = a.state;
        var b = nextRandom(state.prng); state.prng = b.state;
        nx += (a.value - 0.5) * 2 * jig;
        ny += (b.value - 0.5) * 2 * jig;
      }
      if (state.circular) {
        var dx = nx - 0.5, dy = ny - 0.5;
        var rr = Math.sqrt(dx * dx + dy * dy);
        var rMax = 0.499;
        if (rr > rMax) {
          nx = 0.5 + (dx / rr) * rMax;
          ny = 0.5 + (dy / rr) * rMax;
        }
      } else {
        nx = Math.min(1, Math.max(0, nx));
        ny = Math.min(1, Math.max(0, ny));
      }
      state.x[i] = nx;
      state.y[i] = ny;
    }
    return state;
  }

  /** Mean |field| over all particles — falls as sand collects on nodal lines. */
  function meanParticleAbs(state, field) {
    if (state.count === 0) return 0;
    var sum = 0;
    for (var i = 0; i < state.count; i++) sum += Math.abs(field(state.x[i], state.y[i]));
    return sum / state.count;
  }

  CYM.createSand = createSand;
  CYM.stepParticles = stepParticles;
  CYM.meanParticleAbs = meanParticleAbs;

