  CYM.COLORMAPS = Object.keys(COLORMAP_STOPS);

  /**
   * Sample a colormap at t. Out-of-range and non-finite t are clamped to
   * [0, 1] (never throws, never returns NaN).
   */
  function sampleColormap(name, t) {
    var stops = COLORMAP_STOPS[name] || COLORMAP_STOPS['lab-paper'];
    var c = Number.isNaN(t) ? 0 : Math.min(1, Math.max(0, t));
    var pos = c * (stops.length - 1);
    var i = Math.min(stops.length - 2, Math.floor(pos));
    var f = pos - i;
    var a = stops[i], b = stops[i + 1];
    return [
      Math.round(a[0] + (b[0] - a[0]) * f),
      Math.round(a[1] + (b[1] - a[1]) * f),
      Math.round(a[2] + (b[2] - a[2]) * f),
    ];
  }

  CYM.sampleColormap = sampleColormap;

